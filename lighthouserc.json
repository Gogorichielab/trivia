{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/host.html?game=lhci",
        "http://localhost/display.html?game=lhci",
        "http://localhost/scoreboard.html?game=lhci"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "screenEmulation": {
          "width": 1920,
          "height": 1080,
          "deviceScaleFactor": 1,
          "mobile": false
        },
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "off"
        ],
        "unused-javascript": "off",
        "legacy-javascript": "off",
        "uses-long-cache-ttl": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
